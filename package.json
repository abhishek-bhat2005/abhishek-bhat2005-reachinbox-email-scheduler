{
  "name": "reachinbox-email-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev:backend\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace @reachinbox/backend",
    "dev:worker": "npm run dev:worker --workspace @reachinbox/backend",
    "dev:frontend": "npm run dev --workspace @reachinbox/frontend",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @reachinbox/backend",
    "db:generate:deploy": "npm run db:generate:deploy --workspace @reachinbox/backend",
    "db:validate": "npm run db:validate --workspace @reachinbox/backend",
    "db:migrate": "npm run db:migrate --workspace @reachinbox/backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @reachinbox/backend",
    "db:seed": "npm run db:seed --workspace @reachinbox/backend",
    "build:backend": "npm run db:generate:deploy && npm run build --workspace @reachinbox/backend",
    "start:backend": "npm run start --workspace @reachinbox/backend",
    "start:worker": "npm run start:worker --workspace @reachinbox/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "verify:ethereal": "npm run verify:ethereal --workspace @reachinbox/backend",
    "verify:load": "npm run verify:load --workspace @reachinbox/backend",
    "verify:recovery": "npm run verify:recovery --workspace @reachinbox/backend",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
