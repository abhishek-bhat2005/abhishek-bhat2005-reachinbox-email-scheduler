# Copy this file to .env and replace every placeholder locally.
# Never commit .env or real credentials.

# Runtime URLs and ports
NODE_ENV=development
BACKEND_HOST=YOUR_BACKEND_HOST
BACKEND_PORT=YOUR_BACKEND_PORT
FRONTEND_URL=YOUR_FRONTEND_URL
VITE_API_BASE_URL=YOUR_BACKEND_API_URL
VITE_DASHBOARD_REFRESH_MS=YOUR_DASHBOARD_REFRESH_INTERVAL_MS

# PostgreSQL
POSTGRES_IMAGE=YOUR_POSTGRES_IMAGE_TAG
POSTGRES_HOST=YOUR_POSTGRES_HOST
POSTGRES_PORT=YOUR_POSTGRES_PORT
POSTGRES_CONTAINER_PORT=YOUR_POSTGRES_CONTAINER_PORT
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DATABASE
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@YOUR_POSTGRES_HOST:YOUR_POSTGRES_PORT/YOUR_POSTGRES_DATABASE

# Redis and BullMQ
REDIS_IMAGE=YOUR_REDIS_IMAGE_TAG
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=YOUR_REDIS_PORT
REDIS_CONTAINER_PORT=YOUR_REDIS_CONTAINER_PORT
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_OR_EMPTY
REDIS_TLS=YOUR_REDIS_TLS_BOOLEAN
REDIS_URL=redis://YOUR_REDIS_HOST:YOUR_REDIS_PORT
BULLMQ_PREFIX=YOUR_BULLMQ_PREFIX
EMAIL_QUEUE_NAME=YOUR_EMAIL_QUEUE_NAME

# Google OAuth and session security
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=YOUR_GOOGLE_CALLBACK_URL
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SESSION_SECRET
SESSION_COOKIE_NAME=YOUR_SESSION_COOKIE_NAME
SESSION_TTL_MS=YOUR_SESSION_TTL_MS

# Ethereal SMTP
SMTP_HOST=YOUR_ETHEREAL_SMTP_HOST
SMTP_PORT=YOUR_ETHEREAL_SMTP_PORT
SMTP_SECURE=YOUR_SMTP_SECURE_BOOLEAN
SMTP_USER=YOUR_ETHEREAL_SMTP_USERNAME
SMTP_PASSWORD=YOUR_ETHEREAL_SMTP_PASSWORD
SMTP_DEFAULT_FROM_NAME=YOUR_DEFAULT_SENDER_NAME
SMTP_DEFAULT_FROM_EMAIL=YOUR_DEFAULT_SENDER_EMAIL
SMTP_CONNECTION_TIMEOUT_MS=YOUR_SMTP_CONNECTION_TIMEOUT_MS
SMTP_SOCKET_TIMEOUT_MS=YOUR_SMTP_SOCKET_TIMEOUT_MS

# Worker and sender policy
WORKER_CONCURRENCY=YOUR_WORKER_CONCURRENCY
DEFAULT_MIN_SEND_DELAY_MS=YOUR_DEFAULT_SEND_DELAY_MS
MIN_SEND_DELAY_MS=YOUR_MINIMUM_ALLOWED_SEND_DELAY_MS
MAX_SEND_DELAY_MS=YOUR_MAXIMUM_ALLOWED_SEND_DELAY_MS
DEFAULT_EMAILS_PER_HOUR=YOUR_DEFAULT_HOURLY_LIMIT
MAX_EMAILS_PER_HOUR=YOUR_MAXIMUM_ALLOWED_HOURLY_LIMIT
SMTP_MAX_ATTEMPTS=YOUR_SMTP_MAX_ATTEMPTS
SMTP_BACKOFF_MS=YOUR_SMTP_BACKOFF_MS
PROCESSING_LEASE_MS=YOUR_PROCESSING_LEASE_MS
JOB_RETENTION_COUNT=YOUR_JOB_RETENTION_COUNT
RECONCILIATION_BATCH_SIZE=YOUR_RECONCILIATION_BATCH_SIZE
RATE_LIMIT_RESERVATION_TTL_MS=YOUR_RATE_LIMIT_RESERVATION_TTL_MS

# API and upload limits
MAX_UPLOAD_BYTES=YOUR_MAX_UPLOAD_BYTES
MAX_LEADS_PER_BATCH=YOUR_MAX_LEADS_PER_BATCH
MAX_SUBJECT_LENGTH=YOUR_MAX_SUBJECT_LENGTH
MAX_BODY_LENGTH=YOUR_MAX_BODY_LENGTH
MAX_SCHEDULE_HORIZON_DAYS=YOUR_MAX_SCHEDULE_HORIZON_DAYS
API_PAGE_SIZE=YOUR_DEFAULT_API_PAGE_SIZE
API_MAX_PAGE_SIZE=YOUR_MAXIMUM_API_PAGE_SIZE
LOG_LEVEL=YOUR_LOG_LEVEL
